# Template for .env — copy to .env and fill in real values.
#
#   cp .env.example .env
#
# .env is gitignored and MUST stay that way: this repository is PUBLIC.
# Never commit real credentials. Never use `git add -f` on .env.
#
# Create a Jira API token at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
#
# Used by scripts/fetch-design.sh (download the design image attached to a ticket)
# and scripts/jira-upload.sh (attach the rendered screenshot back to the ticket).

JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here
