{
  "permissions": {
    "allow": [
      "Bash(gh issue *)",
      "Bash(curl *)",
      "Bash(git fetch *)",
      "Bash(git check-ignore *)",
      "Bash(node -e \"console.log\\(JSON.stringify\\(require\\('./package.json'\\).scripts,null,2\\)\\)\")",
      "Bash(python3 -c ' *)",
      "Skill(claude-api)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:mcp-proxy.anthropic.com)",
      "WebFetch(domain:sidekick-library--aem-block-collection--adobe.aem.page)",
      "WebFetch(domain:main--aem-block-collection--adobe.aem.page)"
    ]
  },
  "enabledPlugins": {
    "agentic-core@agenticdraft": true,
    "agentic-eds@agenticdraft": true,
    "agentic-jira@agenticdraft": true,
    "agentic-github@agenticdraft": true,
    "agentic-figma@agenticdraft": true,
    "agentic-playwright@agenticdraft": true
  },
  "extraKnownMarketplaces": {
    "agenticdraft": {
      "source": {
        "source": "github",
        "repo": "agenticDraft/plugins",
        "ref": "v0.2.12"
      }
    }
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "api.atlassian.com",
        "www.figma.com",
        "zmarkoni.atlassian.net",
        "main--aem-eds-ai-workflow-demo--agenticdraft.aem.page",
        "developer.mozilla.org",
        "*.aem.page",
        "*.atlassian.net"
      ]
    }
  }
}
